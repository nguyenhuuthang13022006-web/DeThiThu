@model IEnumerable<HangHoa>
<div class="section group product-list">
@foreach (var item in Model)
{
    <div class="grid_1_of_4 images_1_of_4 product-card">
        <img src="@Url.Content("~/images/" + (string.IsNullOrWhiteSpace(item.Anh) ? "preview.jpg" : item.Anh.Trim()))" alt="@item.TenHang" />
        <h2>@item.TenHang</h2>
        <div class="price-details">
            <div class="price-number"><p><span class="rupees">@((item.Gia ?? 0).ToString("N0"))</span></p></div>
            <div class="add-cart"><h4><a href="#">@item.LoaiHang?.TenLoai</a></h4></div>
            <div class="clear"></div>
        </div>
    </div>
}
</div>
@if (!Model.Any())
{
    <p class="empty-products">Không có hàng hóa phù hợp.</p>
}
